# ==== READ ME ==== #
# Do not use Base URLs if you are using the default API for any LLM.
# If you're using the API key, you do not need to login nor a default URL.

# General LLM settings
MAX_TOKENS=16000
LLM_TEMPERATURE=1.0
RETRIEVAL_MODEL=all-MiniLM-L6-v2
REASONING_EFFORT=medium
HF_TOKEN=

# Used for testing OpenAI
OPENAI_LLM=openai/gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# Kimi K3
KIMI_LLM=kimi/kimi-k3
KIMI_API_KEY=
KIMI_API_BASE=https://api.moonshot.ai/v1

# Anthropic
ANTHROPIC_API_KEY=

# ===================== Ollama ================================
#   Llama
LLAMA_LLM=ollama/llama3.3
#   Deepseek
DEEPSEEK_LLM=ollama/deepseek-v4-flash:0731-cloud
LOCALDS_5B_LLM=ollama/deepseek-r1:1.5b
LOCALDS_14B_LLM=ollama/deepseek-r1:14b
#   Kimi-k3
KIMI_LLM=ollama/kimi-k3:cloud
#   LLM7io
LLM7_LLM=ollama/LLM7io/llm7-graph-270m:latest

# Use the API key for all LLMS & the Base for locally pulled LLM models
OLLAMA_API_KEY=
OLLAMA_BASE=http://localhost:11434
# ==============================================================

# Gemini
# Make sure to run: pip (or pip3) install gcloud
GEMINI_LLM=gemini/gemini-3.5-flash
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/

# Claude
ANTHROPIC_LLM=anthropic/claude-haiku-4-5-20251001 # claude-haiku-4.5
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com/v1

# JSON to CSV conversion directory settings
KG_DIR_INPUT=experiments/MINE/results

# Neo4j database settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kg-gen
NEO4J_DATABASE=neo4j